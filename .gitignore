out-tsc/

# Test and coverage output.
coverage/
.nyc_output/

# Angular cache.
.angular/

# Editor and OS noise.
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local environment files.
.env
.env.local
.env.*.local

# Logs.
*.log
npm-debug.log*
